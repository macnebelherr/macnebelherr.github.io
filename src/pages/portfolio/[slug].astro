export function getStaticPaths() {
  const slugs = [
    'feuerwerk-turnkunst-2024',
    'wildpark-lueneburger-heide-2023',
    'natur-2022',
    'sandkuhle-2019',
    'eulenkasten-2019',
    'vogelpark-walsrode-2017',
  ];
  return slugs.map(slug => ({ params: { slug } }));
}

const gallery = galleries.find(g => g.slug === Astro.params.slug)!;
---

<BaseLayout title={gallery.title} description={gallery.description}>

  <!-- Back link + header -->
  <div class="pt-32 pb-12 px-6 max-w-7xl mx-auto animate-fade-up opacity-0">
    <a href="/portfolio" class="text-zinc-500 hover:text-orange-400 transition-colors text-sm tracking-wider uppercase inline-flex items-center gap-2 mb-8">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"/>
      </svg>
      Zurück zum Portfolio
    </a>
    <p class="text-orange-400 tracking-[0.2em] uppercase text-xs mb-2">{gallery.category} · {gallery.year}</p>
    <h1 class="text-4xl md:text-5xl font-thin">{gallery.title}</h1>
    <p class="text-zinc-400 mt-4 max-w-xl font-light leading-relaxed">{gallery.description}</p>
    <div class="mt-4 w-16 h-px bg-orange-400"></div>
  </div>

  <!-- Image Grid -->
  <div class="max-w-7xl mx-auto px-6 pb-20">
    <div class="columns-1 md:columns-2 gap-4 space-y-4">
      {/* Erstes Bild = Morph-Ziel: eigener Zweig, damit transition:name nur hier
          gesetzt wird und kein .reveal das Ziel unsichtbar macht */}
      {gallery.images.map((src, i) => i === 0 ? (
        <div class="gallery-item break-inside-avoid cursor-zoom-in rounded-xl overflow-hidden" data-lightbox-index={0}>
          <img
            src={src}
            alt={`${gallery.title} – Bild 1`}
            class="w-full block"
            transition:name={`gallery-image-${gallery.slug}`}
            loading="eager"
          />
        </div>
      ) : (
        <div class="reveal gallery-item break-inside-avoid cursor-zoom-in rounded-xl overflow-hidden" data-lightbox-index={i}>
          <img
            src={src}
            alt={`${gallery.title} – Bild ${i + 1}`}
            class="w-full block"
            loading="lazy"
          />
        </div>
      ))}
    </div>
  </div>

  <!-- Lightbox -->
  <div id="lightbox" class="fixed inset-0 bg-zinc-950/95 z-50 hidden items-center justify-center">
    <button data-lightbox-close class="absolute top-6 right-6 text-zinc-400 hover:text-white transition-colors" aria-label="Schließen">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
    <button data-lightbox-prev class="absolute left-4 text-zinc-400 hover:text-white transition-colors p-4" aria-label="Vorheriges Bild">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"/>
      </svg>
    </button>
    <img id="lightbox-img" src="" alt="" class="max-w-[90vw] max-h-[90vh] object-contain rounded-lg" />
    <button data-lightbox-next class="absolute right-4 text-zinc-400 hover:text-white transition-colors p-4" aria-label="Nächstes Bild">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"/>
      </svg>
    </button>
  </div>

</BaseLayout>

<script>
  // Lightbox per Event-Delegation: läuft genau einmal, liest die Bildliste
  // zur Laufzeit aus dem aktuellen DOM – dadurch ClientRouter-kompatibel
  // (funktioniert nach jeder Navigation und für jede Galerie).
  let current = 0;

  const getImages = () =>
    [...document.querySelectorAll<HTMLImageElement>('[data-lightbox-index] img')].map((el) => el.src);

  function show(index: number) {
    const images = getImages();
    if (!images.length) return;
    current = (index + images.length) % images.length;
    const lb = document.getElementById('lightbox');
    const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
    if (!lb || !img) return;
    img.src = images[current];
    lb.classList.remove('hidden');
    lb.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function close() {
    const lb = document.getElementById('lightbox');
    lb?.classList.add('hidden');
    lb?.classList.remove('flex');
    document.body.style.overflow = '';
  }

  document.addEventListener('click', (e) => {
    const t = e.target as Element;
    const item = t.closest<HTMLElement>('[data-lightbox-index]');
    if (item) return show(Number(item.dataset.lightboxIndex));
    if (t.closest('[data-lightbox-prev]')) return show(current - 1);
    if (t.closest('[data-lightbox-next]')) return show(current + 1);
    if (t.closest('[data-lightbox-close]')) return close();
    if (t.closest('#lightbox') && !t.closest('#lightbox-img')) return close();
  });

  document.addEventListener('keydown', (e) => {
    if (!document.getElementById('lightbox')?.classList.contains('flex')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });
</script>
