---
import BaseLayout from '../layouts/BaseLayout.astro';

const cameras = [
  {
    name: 'Sony A7 V',
    tag: 'Vollformat · 35mm',
    desc: 'Meine Hauptkamera für anspruchsvolle Aufnahmen – aktuell mit dem 85mm bestückt, perfekt für Menschen und Porträts, unter anderem auch bei wenig Licht.',
    image: '/images/kamera-a7v.jpg',
  },
  {
    name: 'Sony A6700',
    tag: 'APS-C · Crop-Faktor 1,5×',
    desc: 'Meine kompakte Zweitkamera – aktuell mit dem 17–40mm bestückt, ideal für Sport und Tierfotografie, wo der APS-C-Crop-Faktor effektiv mehr Reichweite bringt.',
    image: '/images/kamera-a6700.jpg',
  },
  {
    name: 'Panasonic Lumix DMC-LX15',
    tag: 'Kompaktkamera · 1"-Sensor',
    desc: 'Meine Immer-dabei-Kamera – große Bildqualität im Taschenformat, wenn die Systemkameras zu groß oder zu auffällig sind.',
    image: '/images/kamera-lx15.jpg',
  },
];

const lenses = [
  {
    name: 'Sigma 17–40mm F1.8',
    tag: 'Standardzoom · A6700',
    desc: 'Mein am häufigsten genutztes Objektiv an der A6700 – durchgehend lichtstark mit f/1.8 über den ganzen Zoombereich.',
  },
  {
    name: 'Sony 18–135mm F3.5–5.6',
    tag: 'Kit-Zoom · A6700',
    desc: 'Das klassische Kit-Objektiv – flexibel, aber seltener im Einsatz als das 17–40mm.',
  },
  {
    name: 'Sony FE 85mm F1.8',
    tag: 'Festbrennweite · A7 V',
    desc: 'Häufig im Einsatz für Porträts – knackige Schärfe und schönes Freistellen vom Hintergrund.',
  },
  {
    name: 'Sony FE 70–200mm F2.8 GM',
    tag: 'Telezoom · A7 V',
    desc: 'Sonys Original-Telezoom – mein Allrounder für Aufnahmen aus der Distanz und Sport.',
  },
  {
    name: 'Sigma 24–70mm F2.8 Art',
    tag: 'Standardzoom · A7 V',
    desc: 'Mein vielseitiges Allround-Objektiv. Ein kleiner Kratzer auf der Frontlinse sieht schlimmer aus, als er ist – auf die Bildqualität hat er keinen Einfluss.',
  },
  {
    name: 'Sigma 50mm F1.4 Art',
    tag: 'Festbrennweite · adaptiert',
    desc: 'Ein altes Sigma mit Canon-EF-Anschluss, läuft über einen Adapter an der Sony – bewährt und lichtstark.',
  },
  {
    name: 'Sigma 20mm F1.4 Art',
    tag: 'Super-Weitwinkel',
    desc: 'Für den ganz großen Blickwinkel – mein Weitwinkel für Landschaften und beengte Situationen.',
  },
  {
    name: 'Sigma 105mm F1.4 Art',
    tag: 'Festbrennweite · Porträt',
    desc: 'Mein absolutes Monster-Objektiv für Porträts – unglaublich scharf mit traumhaftem Bokeh.',
  },
  {
    name: 'Sigma 150–600mm F5–6.3',
    tag: 'Supertele',
    desc: 'Reichweite pur – hauptsächlich im Einsatz bei Fußballspielen.',
  },
];
---

<BaseLayout title="Über mich" description="Über Guido Walther – Hobbyfotograf aus Norddeutschland">

  <div class="pt-32 max-w-5xl mx-auto px-6 pb-20">

    <!-- Header -->
    <div class="mb-16 animate-fade-up opacity-0">
      <p class="text-orange-400 tracking-[0.2em] uppercase text-xs mb-3">Der Fotograf</p>
      <h1 class="text-4xl md:text-5xl font-thin">Über mich</h1>
      <div class="mt-4 w-16 h-px bg-orange-400"></div>
    </div>

    <!-- Content -->
    <div class="grid md:grid-cols-2 gap-16 items-start">

      <!-- Portrait placeholder -->
      <div class="relative animate-fade-up opacity-0 delay-200">
        <div class="aspect-[3/4] bg-zinc-900 overflow-hidden rounded-lg portrait-frame">
          <img
            src="/images/me-verlauf-raum.jpg"
            alt="Portrait Guido Walther"
            class="w-full h-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/50 to-transparent"></div>
        </div>
      </div>

      <!-- Text -->
      <div class="space-y-6 animate-fade-up opacity-0 delay-300">
        <div>
          <h2 class="text-2xl font-thin text-orange-400 mb-4">Guido Walther</h2>
          <p class="text-zinc-400 leading-relaxed font-light">
            Seit vielen Jahren fasziniert mich die Fotografie als Weg, besondere Momente
            festzuhalten und die Welt durch ein anderes Auge zu sehen. Was als Hobby begann,
            ist inzwischen ein fester Teil meines Lebens geworden.
          </p>
        </div>

        <p class="text-zinc-400 leading-relaxed font-light">
          Am meisten interessieren mich Menschen: Gesichter, Ausdruck – und vor allem
          der unbeobachtete, unbemerkte Moment. Die besten Bilder entstehen, wenn
          gerade niemand an die Kamera denkt.
        </p>

        <p class="text-zinc-400 leading-relaxed font-light">
          Deshalb fotografiere ich auch gern Hochzeiten – am liebsten Paarshootings
          an außergewöhnlichen Orten, die einem Bild ihre ganz eigene Stimmung geben.
          Und wenn gerade kein Mensch vor der Linse steht, ist es oft mein Hund –
          eines meiner geduldigsten und häufigsten Models.
        </p>

        <p class="text-zinc-400 leading-relaxed font-light">
          Dazu kommt die Actionfotografie im Sport, wo alles auf den richtigen
          Augenblick ankommt. Ob laut oder leise: Am Ende geht es mir immer darum,
          schöne Momente einzufangen.
        </p>

        <!-- Stats -->
        <div class="grid grid-cols-3 gap-6 pt-6 border-t border-zinc-800">
          <div>
            <div class="text-3xl font-thin text-orange-400">6+</div>
            <div class="text-zinc-500 text-sm mt-1">Galerien</div>
          </div>
          <div>
            <div class="text-3xl font-thin text-orange-400">300+</div>
            <div class="text-zinc-500 text-sm mt-1">Fotos auf Flickr</div>
          </div>
          <div>
            <div class="text-3xl font-thin text-orange-400">2017</div>
            <div class="text-zinc-500 text-sm mt-1">Erste Galerie</div>
          </div>
        </div>

        <!-- Links -->
        <div class="pt-4 flex gap-4 flex-wrap">
          <a
            href="https://guidowalther.myportfolio.com"
            target="_blank"
            rel="noopener"
            class="px-6 py-2.5 rounded-full border border-zinc-700 text-sm tracking-wider uppercase hover:border-orange-400 hover:text-orange-400 transition-colors"
          >
            Adobe Portfolio
          </a>
          <a
            href="https://www.flickr.com/photos/macnebelherr"
            target="_blank"
            rel="noopener"
            class="px-6 py-2.5 rounded-full border border-zinc-700 text-sm tracking-wider uppercase hover:border-orange-400 hover:text-orange-400 transition-colors"
          >
            Flickr
          </a>
          <a
            href="https://guido-walther-fotografie.jimdosite.com"
            target="_blank"
            rel="noopener"
            class="px-6 py-2.5 rounded-full border border-zinc-700 text-sm tracking-wider uppercase hover:border-orange-400 hover:text-orange-400 transition-colors"
          >
            Jimdo
          </a>
          <a
            href="/contact"
            class="px-6 py-2.5 rounded-full bg-orange-400 text-zinc-950 text-sm tracking-wider uppercase font-medium hover:bg-orange-300 transition-colors"
          >
            Kontakt
          </a>
        </div>
      </div>
    </div>

    <!-- Ausrüstung -->
    <div class="mt-20 pt-16 border-t border-zinc-800">
      <p class="text-orange-400 tracking-[0.2em] uppercase text-xs mb-2">Mein Equipment</p>
      <h2 class="text-2xl font-thin mb-10">Ausrüstung</h2>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {cameras.map((cam) => (
          <div class="reveal equipment-card bg-zinc-900 rounded-lg border border-zinc-800 overflow-hidden">
            <div class="aspect-[4/3] bg-zinc-950 overflow-hidden">
              <img
                src={cam.image}
                alt={cam.name}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <div class="p-6">
              <h3 class="text-white font-light text-lg">{cam.name}</h3>
              <p class="text-orange-400 text-xs tracking-wider uppercase mt-0.5">{cam.tag}</p>
              <p class="text-zinc-500 text-sm mt-2 leading-relaxed">
                {cam.desc}
              </p>
            </div>
          </div>
        ))}
      </div>

      <!-- Objektive -->
      <p class="text-orange-400 tracking-[0.2em] uppercase text-xs mb-2 mt-14">Je nach Einsatz</p>
      <h3 class="text-xl font-thin mb-6">Objektive</h3>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {lenses.map((lens) => (
          <div class="reveal equipment-card bg-zinc-900 p-5 rounded-lg border border-zinc-800">
            <div class="flex items-start gap-3">
              <div class="text-orange-400 mt-1">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5"/>
                  <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.5"/>
                  <line x1="12" y1="2" x2="12" y2="4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  <line x1="12" y1="20" x2="12" y2="22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  <line x1="2" y1="12" x2="4" y2="12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  <line x1="20" y1="12" x2="22" y2="12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </div>
              <div class="flex-1">
                <h4 class="text-white font-light text-base">{lens.name}</h4>
                <p class="text-orange-400 text-xs tracking-wider uppercase mt-0.5">{lens.tag}</p>
                <p class="text-zinc-500 text-sm mt-2 leading-relaxed">
                  {lens.desc}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>

  </div>
</BaseLayout>
