---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Fotografie-Portfolio von Guido Walther' } = Astro.props;
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Start' },
  { href: '/portfolio', label: 'Portfolio' },
  { href: '/about', label: 'Über mich' },
  { href: '/contact', label: 'Kontakt' },
];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | Guido Walther Fotografie</title>
    <ClientRouter />
  </head>
  <body class="bg-zinc-950 text-zinc-100 min-h-screen flex flex-col">

    <!-- Navigation -->
    <header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300" transition:name="site-header">
      <nav class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
        <a href="/" class="text-xl font-light tracking-widest uppercase text-orange-400 hover:text-orange-300 transition-colors">
          Guido Walther
        </a>

        <!-- Desktop nav -->
        <ul class="hidden md:flex gap-8">
          {navLinks.map(link => (
            <li>
              <a
                href={link.href}
                class={`text-sm tracking-wider uppercase transition-colors duration-200 ${
                  currentPath === link.href
                    ? 'text-orange-400'
                    : 'text-zinc-300 hover:text-orange-400'
                }`}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>

        <!-- Mobile menu button -->
        <button id="menu-toggle" class="md:hidden text-zinc-300 hover:text-orange-400 transition-colors" aria-label="Menü öffnen">
          <svg id="icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </nav>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden md:hidden bg-zinc-950/95 backdrop-blur-md border-t border-zinc-800">
        <ul class="max-w-7xl mx-auto px-6 py-4 flex flex-col gap-4">
          {navLinks.map(link => (
            <li>
              <a
                href={link.href}
                class={`block text-sm tracking-wider uppercase py-2 transition-colors ${
                  currentPath === link.href ? 'text-orange-400' : 'text-zinc-300 hover:text-orange-400'
                }`}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </header>

    <!-- Main content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-zinc-800 mt-20">
      <div class="max-w-7xl mx-auto px-6 py-10 flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-zinc-500 text-sm">© {new Date().getFullYear()} Guido Walther. Alle Rechte vorbehalten.</p>
        <div class="flex gap-6">
          <a href="https://www.flickr.com/photos/macnebelherr" target="_blank" rel="noopener" class="text-zinc-500 hover:text-orange-400 transition-colors text-sm tracking-wide">Flickr</a>
          <a href="https://guidowalther.myportfolio.com" target="_blank" rel="noopener" class="text-zinc-500 hover:text-orange-400 transition-colors text-sm tracking-wide">Adobe Portfolio</a>
          <a href="https://guido-walther-fotografie.jimdosite.com" target="_blank" rel="noopener" class="text-zinc-500 hover:text-orange-400 transition-colors text-sm tracking-wide">Jimdo</a>
          <a href="/contact" class="text-zinc-500 hover:text-orange-400 transition-colors text-sm tracking-wide">Kontakt</a>
        </div>
      </div>
    </footer>

  </body>
</html>

<script>
  // Alle Listener hängen an window/document (Event-Delegation) und lösen
  // DOM-Referenzen erst zur Laufzeit auf – so überleben sie die DOM-Swaps
  // des ClientRouters ohne Doppelregistrierung oder Leaks.

  // Header-Scroll-Effekt
  const HEADER_CLASSES = ['bg-zinc-950/90', 'backdrop-blur-md', 'border-b', 'border-zinc-800'];
  function syncHeader() {
    const header = document.getElementById('site-header');
    const scrolled = window.scrollY > 50;
    HEADER_CLASSES.forEach((c) => header?.classList.toggle(c, scrolled));
  }
  window.addEventListener('scroll', syncHeader, { passive: true });

  // Mobile Menü (Delegation)
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('#menu-toggle')) return;
    document.getElementById('mobile-menu')?.classList.toggle('hidden');
    document.getElementById('icon-open')?.classList.toggle('hidden');
    document.getElementById('icon-close')?.classList.toggle('hidden');
  });

  // Scroll-Reveal: alle .reveal-Elemente blenden weich ein, sobald sie ins Bild scrollen.
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12 }
  );

  // Feuert beim ersten Laden UND nach jeder Client-Navigation
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('.reveal:not(.in-view)').forEach((el, i) => {
      el.style.transitionDelay = `${(i % 6) * 100}ms`;
      revealObserver.observe(el);
    });
    syncHeader();

    // Lens-Flare auf der Startseite nur einmal pro Besuch abspielen
    const flare = document.querySelector('.flare-container');
    if (flare) {
      if (sessionStorage.getItem('flare-shown')) flare.remove();
      else sessionStorage.setItem('flare-shown', '1');
    }
  });

  document.addEventListener('astro:before-swap', () => revealObserver.disconnect());

  // Läuft synchron VOR dem Snapshot der neuen Seite: sichtbare .reveal-Elemente
  // sofort einblenden, damit Morph-Ziele nicht unsichtbar sind und nichts nachflackert.
  document.addEventListener('astro:after-swap', () => {
    document.querySelectorAll<HTMLElement>('.reveal').forEach((el) => {
      const r = el.getBoundingClientRect();
      if (r.top < window.innerHeight && r.bottom > 0) el.classList.add('in-view');
    });
  });
</script>
